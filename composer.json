{
    "name": "spyrit/spyrit-essential-sf-bundle",
    "description": "Bundle Symfony transverse SPYRIT (utilitaires communs aux applications internes)",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/config": "^5.4|^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^5.4|^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^5.4|^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^5.4|^6.4|^7.0|^8.0",
        "symfony/process": "^5.4|^6.4|^7.0|^8.0",
        "symfony/routing": "^5.4|^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.0|^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.5|^13.4",
        "symfony/framework-bundle": "^6.4|^7.4",
        "symfony/yaml": "^6.4|^7.4"
    },
    "suggest": {
        "doctrine/dbal": "Pour exposer la version live de la base de données (MySQL/MariaDB/PostgreSQL) sur la route /spyrit-essential"
    },
    "autoload": {
        "psr-4": {
            "Spyrit\\EssentialBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spyrit\\EssentialBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "fix": [
            "vendor/bin/php-cs-fixer fix",
            "vendor/bin/phpstan analyse"
        ],
        "test": "vendor/bin/phpunit"
    }
}
